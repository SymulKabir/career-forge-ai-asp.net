```gitignore
# =========================
# ASP.NET Core / .NET
# =========================

# Build output
[Bb]in/
[Oo]bj/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.userprefs

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code
.vscode/

# Test results
TestResults/
*.trx

# NuGet
packages/
*.nupkg
*.snupkg
.nuget/

# ASP.NET Core generated files
wwwroot/lib/

# Publish output
publish/
wwwroot/publish/

# Logs
*.log
logs/


# =========================
# Node.js / Tailwind CSS
# =========================

node_modules/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Package manager cache
.npm/
.yarn/
.pnpm-store/

# Tailwind generated CSS
# Uncomment if you don't want to commit generated CSS
# wwwroot/css/app.css


# =========================
# Environment / Secrets
# =========================

.env
.env.*
!.env.example

# ASP.NET local settings
appsettings.Local.json

# User secrets
secrets.json


# =========================
# Database
# =========================

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf


# =========================
# OS Files
# =========================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~


# =========================
# Temporary Files
# =========================

*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig

# Crash dumps
*.dmp


# =========================
# Coverage
# =========================

coverage/
.coverage/
*.coverage
*.coveragexml


# =========================
# Docker
# =========================

docker-compose.override.yml


# =========================
# Generated / Temporary
# =========================

artifacts/
TestResults/
Generated/
```
