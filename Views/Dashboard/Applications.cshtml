              </div>

              <h3 class="mt-4 text-sm font-bold">
                No applications found
              </h3>

              <p class="mx-auto mt-1 max-w-sm text-xs leading-5 text-slate-400">
                Try changing your search or filters, or add a new application.
              </p>

            </div>


            <!-- Pagination -->

            <div
              class="mt-5 flex flex-col gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-between"
            >

              <p
                id="resultsText"
                class="text-xs text-slate-400"
              >
                Showing 1–6 of 24 applications
              </p>

              <div class="flex items-center gap-1">

                <button
                  id="prevPage"
                  onclick="changePage(-1)"
                  class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-sm text-slate-400 hover:bg-slate-50"
                >
                  ←
                </button>

                <div id="pageNumbers" class="flex gap-1"></div>

                <button
                  id="nextPage"
                  onclick="changePage(1)"
                  class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-sm text-slate-500 hover:bg-slate-50"
                >
                  →
                </button>

              </div>

            </div>

          </section>


          <!-- ===================================================== -->
          <!-- FOLLOW UP REMINDER -->
          <!-- ===================================================== -->

          <section
            class="grid gap-6 lg:grid-cols-[1.4fr_0.6fr]"
          >

            <!-- Follow ups -->

            <div
              class="rounded-2xl border border-slate-200 bg-white p-5 shadow-card sm:p-6"
            >

              <div class="flex items-center justify-between">

                <div>

                  <h2 class="text-base font-bold">
                    Upcoming follow-ups
                  </h2>

                  <p class="mt-1 text-xs text-slate-400">
                    Stay proactive with your applications
                  </p>

                </div>

                <button
                  class="rounded-lg bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-violet-50 hover:text-violet-600"
                >
                  View calendar
                </button>

              </div>


              <div class="mt-5 space-y-3">

                <!-- Follow up -->

                <div
                  class="flex items-center gap-4 rounded-xl border border-slate-100 bg-slate-50/70 p-4"
                >

                  <div
                    class="flex h-11 w-11 shrink-0 flex-col items-center justify-center rounded-xl bg-white shadow-sm"
                  >
                    <span class="text-[9px] font-bold uppercase text-red-500">
                      Aug
                    </span>

                    <span class="text-sm font-extrabold">
                      27
                    </span>
                  </div>

                  <div class="min-w-0 flex-1">

                    <h3 class="truncate text-sm font-bold">
                      Senior Full Stack Developer
                    </h3>

                    <p class="mt-1 text-xs text-slate-400">
                      Google · Follow up after application
                    </p>

                  </div>

                  <button
                    class="hidden rounded-lg bg-white px-3 py-2 text-xs font-semibold text-slate-600 shadow-sm hover:text-violet-600 sm:block"
                  >
                    Follow up
                  </button>

                </div>


                <!-- Follow up -->

                <div
                  class="flex items-center gap-4 rounded-xl border border-slate-100 bg-slate-50/70 p-4"
                >

                  <div
                    class="flex h-11 w-11 shrink-0 flex-col items-center justify-center rounded-xl bg-white shadow-sm"
                  >
                    <span class="text-[9px] font-bold uppercase text-orange-500">
                      Aug
                    </span>

                    <span class="text-sm font-extrabold">
                      29
                    </span>
                  </div>

                  <div class="min-w-0 flex-1">

                    <h3 class="truncate text-sm font-bold">
                      Senior .NET Developer
                    </h3>

                    <p class="mt-1 text-xs text-slate-400">
                      Interhyp Group · Recruiter follow-up
                    </p>

                  </div>

                  <button
                    class="hidden rounded-lg bg-white px-3 py-2 text-xs font-semibold text-slate-600 shadow-sm hover:text-violet-600 sm:block"
                  >
                    Follow up
                  </button>

                </div>

              </div>

            </div>


            <!-- Application success -->

            <div
              class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-violet-700 via-indigo-700 to-blue-700 p-6 text-white shadow-lg shadow-violet-200"
            >

              <div
                class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10 blur-3xl"
              ></div>

              <div class="relative">

                <div
                  class="text-[10px] font-bold uppercase tracking-widest text-violet-200"
                >
                  Application health
                </div>

                <div class="mt-5 text-4xl font-extrabold">
                  16.7%
                </div>

                <p class="mt-2 text-xs leading-5 text-violet-100">
                  Your current application-to-interview conversion rate.
                </p>

                <div class="mt-6 h-2 overflow-hidden rounded-full bg-white/20">

                  <div
                    class="h-full w-[66%] rounded-full bg-white"
                  ></div>

                </div>

                <div class="mt-3 flex justify-between text-[10px] text-violet-200">

                  <span>
                    Industry average
                  </span>

                  <span>
                    12.4%
                  </span>

                </div>

                <button
                  class="mt-6 w-full rounded-xl bg-white px-4 py-3 text-xs font-bold text-violet-700 hover:-translate-y-0.5"
                >
                  Improve Applications →
                </button>

              </div>

            </div>

          </section>

        </div>