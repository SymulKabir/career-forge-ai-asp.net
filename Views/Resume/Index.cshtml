        dates: "2015 — 2019",
      },
    ],
    skills: [
      "React",
      "Next.js",
      "Node.js",
      "Python",
      "PostgreSQL",
      "Docker",
    ],
    projects: [
      {
        name: "AI Career Platform",
        description:
          "Built an AI-assisted resume and job matching platform with semantic search and automated tailoring.",
      },
    ],
    certifications: [],
  };

  const forms = document.getElementById("forms");
  const paper = document.getElementById("resumePaper");

  function input(label, key, value, type = "text") {
    return `<label class="block mt-3"><span class="mb-1.5 block text-[10px] font-bold text-slate-500">${label}</span><input
data-bind="${key}" type="${type}" value="${escapeHtml(value || "")}" class="w-full rounded-xl border border-slate-200
bg-slate-50 px-3 py-2.5 text-xs outline-none focus:border-violet-300 focus:bg-white focus:ring-4
focus:ring-violet-50"></label>`;
  }
  function textarea(label, key, value) {
    return `<label class="block mt-3"><span class="mb-1.5 block text-[10px] font-bold
text-slate-500">${label}</span><textarea data-bind="${key}" rows="5" class="w-full resize-y rounded-xl border
border-slate-200 bg-slate-50 px-3 py-2.5 text-xs leading-5 outline-none focus:border-violet-300
focus:bg-white">${escapeHtml(value || "")}</textarea></label>`;
  }
  function escapeHtml(s) {
    return String(s).replace(
      /[&<>"']/g,
      (m) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;",
        })[m],
    );
  }

  function renderForm(section) {
    if (section === "personal")
      forms.innerHTML = `<div class="rounded-2xl border border-slate-200 p-4">
    <div class="flex items-center justify-between"><h3 class="text-xs font-extrabold">Personal information</h3><span
class="text-[9px] text-emerald-600 font-bold">Complete</span></div>
    ${input("Full name", "personal.name", state.personal.name)}
    ${input("Professional title", "personal.role", state.personal.role)}
    ${input("Email", "personal.email", state.personal.email, "email")}
    ${input("Phone", "personal.phone", state.personal.phone)}
    ${input("Location", "personal.location", state.personal.location)}
    ${input("LinkedIn / Website", "personal.linkedin", state.personal.linkedin)}
  </div>`;
    if (section === "summary")
      forms.innerHTML = `<div class="rounded-2xl border border-slate-200 p-4"><h3 class="text-xs font-extrabold">Professional
summary</h3>${textarea("Summary", "summary", state.summary)}<button class="mt-3 w-full rounded-xl bg-violet-600 py-2.5
text-[10px] font-bold text-white" onclick="aiRewriteSummary()">✦ Rewrite with AI</button></div>`;
    if (section === "experience")
      forms.innerHTML = `<div class="space-y-3">${state.experience
        .map(
          (e, i) => `<div class="rounded-2xl border border-slate-200 p-4">
    <div class="flex items-center justify-between"><h3 class="text-xs font-extrabold">Experience ${i + 1}</h3><button
onclick="removeExperience(${i})" class="text-[10px] font-bold text-red-500">Remove</button></div>
    ${input("Job title", `experience.${i}.title`, e.title)}${input("Company", `experience.${i}.company`,
e.company)}${input("Location", `experience.${i}.location`, e.location)}${input("Dates", `experience.${i}.dates`,
e.dates)}${textarea("Achievements / bullets", `experience.${i}.bullets`, e.bullets.join("\\n"))}
  </div>`,
        )
        .join(
          "",
        )}<button onclick="addExperience()" class="w-full rounded-xl border border-dashed border-violet-300 py-3 text-[10px]
font-bold text-violet-600">＋ Add experience</button></div>`;
    if (section === "education")
      forms.innerHTML = `<div class="space-y-3">${state.education.map((e, i) => `<div class="rounded-2xl border
border-slate-200 p-4"><div class="flex justify-between"><h3 class="text-xs font-extrabold">Education ${i +
1}</h3><button onclick="removeEducation(${i})" class="text-[10px] text-red-500
font-bold">Remove</button></div>${input("Degree", `education.${i}.degree`, e.degree)}${input("Institution",
`education.${i}.school`, e.school)}${input("Dates", `education.${i}.dates`, e.dates)}</div>`).join("")}<button
onclick="addEducation()" class="w-full rounded-xl border border-dashed border-violet-300 py-3 text-[10px] font-bold
text-violet-600">＋ Add education</button></div>`;
    if (section === "skills")
      forms.innerHTML = `<div class="rounded-2xl border border-slate-200 p-4"><h3 class="text-xs
font-extrabold">Skills</h3>${textarea("One skill per line", "skills", state.skills.join("\\n"))}<p class="mt-2
text-[9px] text-slate-400">Tip: use job-relevant keywords. AI can analyze them for ATS.</p></div>`;
    if (section === "projects")
      forms.innerHTML = `<div class="space-y-3">${state.projects.map((p, i) => `<div class="rounded-2xl border
border-slate-200 p-4"><div class="flex justify-between"><h3 class="text-xs font-extrabold">Project ${i + 1}</h3><button
onclick="removeProject(${i})" class="text-[10px] text-red-500 font-bold">Remove</button></div>${input("Project name",
`projects.${i}.name`, p.name)}${textarea("Description", `projects.${i}.description`,
p.description)}</div>`).join("")}<button onclick="addProject()" class="w-full rounded-xl border border-dashed
border-violet-300 py-3 text-[10px] font-bold text-violet-600">＋ Add project</button></div>`;
    if (section === "certifications")
      forms.innerHTML = `<div class="rounded-2xl border border-slate-200 p-4"><h3 class="text-xs
font-extrabold">Certifications</h3>${textarea("Certification list", "certifications",
state.certifications.join("\\n"))}<p class="mt-2 text-[9px] text-slate-400">Add certification, issuer and year on
separate lines.</p></div>`;
    forms
      .querySelectorAll("[data-bind]")
      .forEach((el) => el.addEventListener("input", bindChange));
  }
  function get(obj, path) {
    return path.split(".").reduce((a, k) => a?.[k], obj);
  }
  function set(obj, path, val) {
    const parts = path.split(".");
    const last = parts.pop();
    let cur = obj;
    parts.forEach((p) => {
      if (!cur[p]) cur[p] = {};
      cur = cur[p];
    });
    cur[last] = val;
  }
  function bindChange(e) {
    let v = e.target.value,
      key = e.target.dataset.bind;
    if (key.startsWith("experience.") && key.endsWith(".bullets"))
      v = v.split("\n").filter(Boolean);
    if (key === "skills")
      v = v
        .split("\n")
        .map((x) => x.trim())
        .filter(Boolean);
    if (key === "certifications")
      v = v
        .split("\n")
        .map((x) => x.trim())
        .filter(Boolean);
    set(state, key, v);
    renderResume();
    markSaved();
  }
  function renderResume() {
