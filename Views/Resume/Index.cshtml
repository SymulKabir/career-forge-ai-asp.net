@using Microsoft.VisualBasic
@using CareerForgeAI.Resume
@{
  var layoutItems = ResumeUtils.DefaultResumeLayout;
}


<partial name="./Partials/_ToolBar" />

<div class="editor-shell 
  relative 
  min-h-0 
  overflow-hidden 
  h-[calc(100vh_-_65px-_@ResumeUtils.HeaderHeight)] 
  flex justify-center
  ">
  <section id="toolBox" class="absolute 
    left-[-@ResumeUtils.EditorShell.LeftSectionWidth]  
    top-[0px] 
    w-[@ResumeUtils.EditorShell.LeftSectionWidth] 
    h-[inherit]
    overflow-x-visible
    border-r 
    border-slate-200 
    bg-white 
    p-4 
    sm:p-5  
    transition-all 
    duration-300 
    ease-in-out
    z-[2]
    ">
    <!-- Close button -->
    <partial name="./Partials/ToolBox/_CloseButton" />

    <div class="h-full overflow-y-auto">
      <partial name="./Partials/ToolBox/_AiAssistant" />
      <partial name="./Partials/ToolBox/_FixResume" />
      <partial name="./Partials/ToolBox/_CheckAndTailor" />
      <partial name="./Partials/ToolBox/_Templates" />
      <partial name="./Partials/ToolBox/_Design&Font" />
    </div>

  </section>
  <partial name="./Partials/Layout/_ResumeRearrangeModal" />


 
  <section id="previewPanel"
           class="canvas w-[@ResumeUtils.EditorShell.MiddleSectionWidth] min-h-0 overflow-auto overscroll-contain bg-slate-100/80 p-4 sm:p-7 lg:p-10 z-[1]">
    <!-- Preview toolbar -->
    <div class="sticky top-0 mx-auto mb-5 flex max-w-[794px] items-center justify-between gap-3 pb-1">
      <!-- A4 indicator -->
      <div
        class="rounded-full border border-slate-200/80 bg-white/90 px-3 py-1.5 text-[10px] font-bold text-slate-500 shadow-sm backdrop-blur">
        A4 · 210 × 297 mm
      </div>

      <!-- Zoom controls -->
      <div
        class="flex items-center gap-1 rounded-xl border border-slate-200/80 bg-white/90 p-1 shadow-sm backdrop-blur">
        <button id="zoomOut" type="button" title="Zoom out"
                class="flex h-7 w-7 items-center justify-center rounded-lg text-sm font-bold text-slate-500 transition hover:bg-slate-100 hover:text-violet-600">
          −
        </button>

        <span id="zoomLabel" class="w-10 text-center text-[10px] font-bold text-slate-600">
          80%
        </span>

        <button id="zoomIn" type="button" title="Zoom in"
                class="flex h-7 w-7 items-center justify-center rounded-lg text-sm font-bold text-slate-500 transition hover:bg-slate-100 hover:text-violet-600">
          +
        </button>
      </div>
    </div>


    <!-- Resume paper -->
    <div id="paperWrap" class="mx-auto origin-top transition-transform duration-200" style="width: min(100%, 794px)">
      <article id="resumePaper" data-template="modern" class="paper mx-auto min-h-[1123px] w-full bg-white shadow-xl"
               style="--accent: #7c3aed; font-family: Inter, sans-serif">
        <!-- Sidebar -->
        <div class="sidebar-col"></div>

        <!-- Main -->
        <div class="main-col">

          <!-- Header -->
          <div class="flex items-start justify-between gap-5">
            <div>
              <h2 id="rName" class="editable text-[32px] font-extrabold tracking-tight">
                Alex Morgan
              </h2>

              <p id="rRole" class="editable mt-1 text-sm font-semibold" style="color: var(--accent)">
                Senior Software Engineer
              </p>
            </div>

            <div id="rContact" class="contact-light max-w-[220px] text-right text-[10px] leading-5 text-slate-500">
              alex@email.com<br />
              +1 234 567 890<br />
              New York, USA<br />
              linkedin.com/in/alexmorgan
            </div>
          </div>

          <!-- Accent line -->
          <div class="mt-5 h-1 rounded-full" style="background: var(--accent)"></div>


          <!-- Summary -->
          <section class="cv-section mt-7" data-key="summary">
            <h3 class="section-title text-[11px] font-extrabold uppercase tracking-[.16em]">
              Profile
            </h3>

            <p id="rSummary" class="editable mt-2 text-[10.5px] leading-5 text-slate-600">
              Product-minded software engineer with 6+ years of
              experience building scalable web applications, APIs and
              AI-powered products. Strong background in React, Node.js,
              Python and cloud infrastructure.
            </p>
          </section>


          <!-- Experience -->
          <section class="cv-section mt-7" data-key="experience">
            <div class="flex items-center justify-between">
              <h3 class="section-title text-[11px] font-extrabold uppercase tracking-[.16em]">
                Experience
              </h3>
            </div>

            <div id="rExperience" class="mt-3 space-y-4">
              <div class="cv-item">
                <div class="flex justify-between gap-4">
                  <div>
                    <div class="text-[11px] font-bold">
                      Senior Software Engineer
                    </div>

                    <div class="text-[9px] text-slate-500">
                      Tech Company · New York
                    </div>
                  </div>

                  <div class="text-[9px] text-slate-400">
                    2022 — Present
                  </div>
                </div>

                <ul class="mt-2 list-disc space-y-1 pl-4 text-[9.5px] leading-4 text-slate-600">
                  <li>
                    Led development of scalable customer-facing web
                    applications.
                  </li>

                  <li>
                    Improved API performance and reduced infrastructure
                    cost by 28%.
                  </li>
                </ul>
              </div>


              <div class="cv-item">
                <div class="flex justify-between gap-4">
                  <div>
                    <div class="text-[11px] font-bold">
                      Software Engineer
                    </div>

                    <div class="text-[9px] text-slate-500">
                      Digital Studio · Remote
                    </div>
                  </div>

                  <div class="text-[9px] text-slate-400">
                    2019 — 2022
                  </div>
                </div>

                <ul class="mt-2 list-disc space-y-1 pl-4 text-[9.5px] leading-4 text-slate-600">
                  <li>
                    Built full-stack products using React, Node.js and
                    PostgreSQL.
                  </li>

                  <li>
                    Collaborated with designers and product teams to ship
                    features.
                  </li>
                </ul>
              </div>
            </div>
          </section>


          <!-- Education -->
          <section class="cv-section mt-7" data-key="education">
            <h3 class="section-title text-[11px] font-extrabold uppercase tracking-[.16em]">
              Education
            </h3>

            <div id="rEducation" class="mt-3">
              <div class="flex justify-between gap-4">
                <div>
                  <div class="text-[11px] font-bold">
                    B.Sc. in Computer Science
                  </div>

                  <div class="text-[9px] text-slate-500">
                    University of Technology
                  </div>
                </div>

                <div class="text-[9px] text-slate-400">
                  2015 — 2019
                </div>
              </div>
            </div>
          </section>


          <!-- Skills -->
          <section class="cv-section mt-7" data-key="skills">
            <h3 class="section-title text-[11px] font-extrabold uppercase tracking-[.16em]">
              Skills
            </h3>

            <div id="rSkills" class="mt-3 flex flex-wrap gap-1.5">
              <span class="rounded bg-violet-50 px-2 py-1 text-[8.5px] font-semibold" style="color: var(--accent)">
                React
              </span>

              <span class="rounded bg-violet-50 px-2 py-1 text-[8.5px] font-semibold" style="color: var(--accent)">
                Next.js
              </span>

              <span class="rounded bg-violet-50 px-2 py-1 text-[8.5px] font-semibold" style="color: var(--accent)">
                Node.js
              </span>

              <span class="rounded bg-violet-50 px-2 py-1 text-[8.5px] font-semibold" style="color: var(--accent)">
                Python
              </span>

              <span class="rounded bg-violet-50 px-2 py-1 text-[8.5px] font-semibold" style="color: var(--accent)">
                PostgreSQL
              </span>

              <span class="rounded bg-violet-50 px-2 py-1 text-[8.5px] font-semibold" style="color: var(--accent)">
                Docker
              </span>
            </div>
          </section>


          <!-- Projects -->
          <section class="cv-section mt-7" data-key="projects">
            <h3 class="section-title text-[11px] font-extrabold uppercase tracking-[.16em]">
              Projects
            </h3>

            <div id="rProjects" class="mt-3 space-y-2">
              <div>
                <div class="text-[10px] font-bold">
                  AI Career Platform
                </div>

                <p class="text-[9px] leading-4 text-slate-600">
                  Built an AI-assisted resume and job matching platform
                  with semantic search and automated tailoring.
                </p>
              </div>
            </div>
          </section>

        </div>
      </article>
    </div>
  </section>

 
  <aside id="rightPanel"
         class="min-h-0 overflow-y-auto overscroll-contain border-l border-slate-200 bg-white p-4 sm:p-5 hidden">
    <div class="mb-5 flex items-center justify-between">
      <div>
        <h2 class="text-sm font-extrabold">
          Design & AI
        </h2>

        <p class="mt-1 text-[11px] text-slate-400">
          Make it yours.
        </p>
      </div>

      <span class="rounded-lg bg-emerald-50 px-2 py-1 text-[9px] font-bold text-emerald-600">
        ATS 92
      </span>
    </div>


    <!-- Template -->
    <div class="rounded-2xl border border-slate-200 p-4">
      <div class="flex items-center justify-between">
        <h3 class="text-xs font-bold">
          Template
        </h3>

        <button id="allTemplates" type="button" class="text-[10px] font-bold text-violet-600">
          View all
        </button>
      </div>

      <div class="mt-3 grid grid-cols-3 gap-2">
        <button class="template-choice rounded-xl border-2 border-violet-500 bg-violet-50 p-1.5" data-template="modern">
          <div class="mini-paper p-2">
            <div class="h-2 w-16 bg-slate-900"></div>
            <div class="mt-2 h-1 w-12 bg-violet-500"></div>
            <div class="mt-3 h-1 w-full bg-slate-200"></div>
            <div class="mt-1 h-1 w-4/5 bg-slate-200"></div>
          </div>

          <span class="mt-1 block text-[9px] font-bold">
            Modern
          </span>
        </button>

        <button class="template-choice rounded-xl border border-slate-200 p-1.5 transition hover:border-violet-300"
                data-template="classic">
          <div class="mini-paper p-2">
            <div class="mx-auto h-2 w-16 bg-slate-900"></div>
            <div class="mt-3 h-1 w-full bg-slate-300"></div>
            <div class="mt-3 h-1 w-full bg-slate-200"></div>
            <div class="mt-1 h-1 w-4/5 bg-slate-200"></div>
          </div>

          <span class="mt-1 block text-[9px] font-bold">
            Classic
          </span>
        </button>

        <button class="template-choice rounded-xl border border-slate-200 p-1.5 transition hover:border-violet-300"
                data-template="sidebar">
          <div class="mini-paper grid grid-cols-[30%_70%]">
            <div class="bg-slate-900"></div>

            <div class="p-2">
              <div class="h-2 w-10 bg-slate-900"></div>
              <div class="mt-3 h-1 w-full bg-slate-200"></div>
              <div class="mt-1 h-1 w-4/5 bg-slate-200"></div>
            </div>
          </div>

          <span class="mt-1 block text-[9px] font-bold">
            Sidebar
          </span>
        </button>
      </div>
    </div>


    <!-- Accent color -->
    <div class="mt-4 rounded-2xl border border-slate-200 p-4">
      <h3 class="text-xs font-bold">
        Accent color
      </h3>

      <div id="colors" class="mt-3 flex flex-wrap gap-2">
        <button class="h-8 w-8 rounded-full ring-2 ring-violet-500 ring-offset-2" style="background:#7c3aed"
                data-color="#7c3aed"></button>

        <button class="h-8 w-8 rounded-full" style="background:#2563eb" data-color="#2563eb"></button>

        <button class="h-8 w-8 rounded-full" style="background:#0891b2" data-color="#0891b2"></button>

        <button class="h-8 w-8 rounded-full" style="background:#059669" data-color="#059669"></button>

        <button class="h-8 w-8 rounded-full" style="background:#dc2626" data-color="#dc2626"></button>

        <button class="h-8 w-8 rounded-full" style="background:#ea580c" data-color="#ea580c"></button>

        <input id="customColor" type="color" value="#7c3aed"
               class="h-8 w-8 cursor-pointer rounded-full border-0 bg-transparent" title="Custom color" />
      </div>
    </div>


    <!-- Typography -->
    <div class="mt-4 rounded-2xl border border-slate-200 p-4">
      <h3 class="text-xs font-bold">
        Typography
      </h3>

      <select id="fontSelect"
              class="mt-3 h-10 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-xs font-medium outline-none transition focus:border-violet-300">
        <option value="Inter">Inter</option>
        <option value="DM Sans">DM Sans</option>
        <option value="Roboto Slab">Roboto Slab</option>
        <option value="Merriweather">Merriweather</option>
        <option value="Georgia">Georgia</option>
      </select>

      <div class="mt-4">
        <div class="flex justify-between text-[10px] font-bold text-slate-500">
          <span>Base size</span>
          <span id="fontSizeLabel">10.5px</span>
        </div>

        <input id="fontSize" type="range" min="8" max="13" step=".5" value="10.5" class="range mt-2 w-full" />
      </div>

      <div class="mt-4">
        <div class="flex justify-between text-[10px] font-bold text-slate-500">
          <span>Spacing</span>
          <span id="spacingLabel">7</span>
        </div>

        <input id="spacing" type="range" min="3" max="14" value="7" class="range mt-2 w-full" />
      </div>
    </div>


    <!-- AI Coach -->
    <div class="mt-4 rounded-2xl border border-violet-100 bg-gradient-to-br from-violet-50 to-indigo-50 p-4">
      <div class="flex gap-3">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-violet-600 shadow-sm">
          ✦
        </div>

        <div>
          <h3 class="text-xs font-extrabold">
            AI Resume Coach
          </h3>

          <p class="mt-1 text-[10px] leading-4 text-slate-500">
            Your summary is strong. Add measurable outcomes to your
            experience bullets.
          </p>
        </div>
      </div>

      <button id="coachBtn" type="button"
              class="mt-3 w-full rounded-xl bg-white py-2.5 text-[10px] font-bold text-violet-600 shadow-sm transition hover:bg-violet-100">
        Improve my resume →
      </button>
    </div>


    <!-- ATS -->
    <div class="mt-4 rounded-2xl border border-slate-200 p-4">
      <div class="flex items-center justify-between">
        <h3 class="text-xs font-bold">
          ATS readiness
        </h3>

        <span class="text-sm font-extrabold text-emerald-600">
          92%
        </span>
      </div>

      <div class="mt-3 h-2 rounded-full bg-slate-100">
        <div class="h-full w-[92%] rounded-full bg-gradient-to-r from-violet-600 to-cyan-500"></div>
      </div>

      <div class="mt-3 space-y-2 text-[10px] text-slate-500">
        <div class="flex justify-between">
          <span>Keywords</span>
          <b class="text-emerald-600">Excellent</b>
        </div>

        <div class="flex justify-between">
          <span>Formatting</span>
          <b class="text-emerald-600">Excellent</b>
        </div>

        <div class="flex justify-between">
          <span>Impact statements</span>
          <b class="text-amber-600">Improve</b>
        </div>
      </div>
    </div>

    <!-- Bottom breathing room -->
    <div class="h-6"></div>
  </aside>
</div>

@* <script>
  const state = {
    personal: {
      name: "Alex Morgan",
      role: "Senior Software Engineer",
      email: "alex@email.com",
      phone: "+1 234 567 890",
      location: "New York, USA",
      linkedin: "linkedin.com/in/alexmorgan",
    },
    summary:
      "Product-minded software engineer with 6+ years of experience building scalable web applications, APIs and AI-powered
products. Strong background in React, Node.js, Python and cloud infrastructure.",
    experience: [
