@model CareerForgeAI.Resume.Models.ResumeLayoutItem
<link rel="stylesheet"
      href="~/css/views/resume/partials/layout/resumeLayoutCard.css"
      asp-append-version="true" />
<script type="module"  src="~/js/views/resume/partials/layout/resumeLayoutCard.js" defer asp-append-version="true"></script>

<div
    class="layout-card group relative mb-1.5 flex min-h-[48px] cursor-grab select-none items-center rounded-md border border-transparent bg-slate-100 px-2 py-2 text-center transition-all duration-150 hover:border-violet-200 hover:bg-violet-50 active:cursor-grabbing sm:min-h-[52px]"
    data-id="@Model.Id"
    data-section="@Model.Section"
    data-title="@Model.Title"
    draggable="@(!Model.Locked)"

>
    
    <!-- Drag handle -->

    <div
        class="absolute left-1.5 top-1.5 flex flex-col gap-[2px] opacity-50"
    >
        <span class="h-[2px] w-[2px] rounded-full bg-slate-500"></span>
        <span class="h-[2px] w-[2px] rounded-full bg-slate-500"></span>
        <span class="h-[2px] w-[2px] rounded-full bg-slate-500"></span>
    </div>


    <!-- Content -->

    <div class="w-full px-2">

        <div
            class="truncate text-[9px] font-semibold text-slate-700 sm:text-[10px]"
        >
            @(Model.ShortTitle ?? Model.Title)
        </div>

        @if (Model.Locked)
        {
            <div
                class="mt-0.5 text-[7px] font-medium text-slate-400"
            >
                Locked
            </div>
        }

    </div>


    <!-- Lock -->

    @if (Model.Locked)
    {
        <div
            class="absolute right-1.5 top-1.5 text-slate-400"
            title="This section cannot be moved"
        >
            <svg
                class="h-3 w-3"
                fill="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2Zm-7-2a2 2 0 0 1 4 0v2h-4V6Zm5 11H9v-5h6v5Z"
                />
            </svg>
        </div>
    }

</div>

