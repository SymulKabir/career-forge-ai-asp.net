@using CareerForgeAI.Resume
<link rel="stylesheet"
      href="~/css/views/resume/resume-editor.css"
      asp-append-version="true" />

<section id="previewPanel"
         class="canvas w-[@ResumeUtils.EditorShell.MiddleSectionWidth]
                min-h-0 overflow-auto overscroll-contain
                bg-slate-100/80 p-4 sm:p-7 lg:p-10 z-[1]">

    <!-- Toolbar -->
    <div class="sticky top-0 z-30 mx-auto mb-5 flex max-w-[794px]
                items-center justify-between gap-3 pb-1">

        <div class="flex items-center gap-2">

            <div class="rounded-full border border-slate-200/80
                        bg-white/90 px-3 py-1.5 text-[10px]
                        font-bold text-slate-500 shadow-sm backdrop-blur">
                A4 · 210 × 297 mm
            </div>

            <button id="addSectionBtn"
                    type="button"
                    class="rounded-lg bg-violet-600 px-3 py-1.5
                           text-[10px] font-bold text-white
                           hover:bg-violet-700">
                + Section
            </button>

        </div>

        <!-- Zoom -->
        <div class="flex items-center gap-1 rounded-xl
                    border border-slate-200/80 bg-white/90
                    p-1 shadow-sm backdrop-blur">

            <button id="zoomOut"
                    type="button"
                    title="Zoom out"
                    class="flex h-7 w-7 items-center justify-center
                           rounded-lg text-sm font-bold text-slate-500
                           hover:bg-slate-100 hover:text-violet-600">
                −
            </button>

            <span id="zoomLabel"
                  class="w-10 text-center text-[10px]
                         font-bold text-slate-600">
                80%
            </span>

            <button id="zoomIn"
                    type="button"
                    title="Zoom in"
                    class="flex h-7 w-7 items-center justify-center
                           rounded-lg text-sm font-bold text-slate-500
                           hover:bg-slate-100 hover:text-violet-600">
                +
            </button>

        </div>

    </div>


    <!-- Paper -->
    <div id="paperWrap"
         class="mx-auto origin-top transition-transform duration-200"
         style="width:min(100%,794px)">

        <article id="resumePaper"
                 class="paper mx-auto min-h-[1123px] w-full bg-white"
                 data-template="modern">

            <!-- Renderer injects everything here -->

        </article>

    </div>

</section>


<!-- Section editor -->
<div id="sectionEditor"
     class="fixed right-5 top-20 z-[100]
            hidden w-[340px] rounded-2xl border
            border-slate-200 bg-white p-4 shadow-2xl">

    <div class="mb-4 flex items-center justify-between">

        <h3 class="text-sm font-bold text-slate-800">
            Edit Section
        </h3>

        <button id="closeSectionEditor"
                class="text-slate-400 hover:text-slate-700">
            ×
        </button>

    </div>

    <div id="sectionEditorContent"></div>

</div>


<script src="~/js/views/resume/default-resume.js"
        asp-append-version="true"></script>

<script src="~/js/views/resume/resume-editor.js"
        defer
        asp-append-version="true"></script>