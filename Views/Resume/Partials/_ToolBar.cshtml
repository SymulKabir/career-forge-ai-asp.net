@using CareerForgeAI.Resume

<link rel="stylesheet"
      href="~/css/views/resume/partials/toolbar.css"
      asp-append-version="true" />
<script src="~/js/views/resume/partials/toolbar.js" defer asp-append-version="true"></script>


<header class="sticky top-[65px] z-40 w-full border-b border-slate-200/70 bg-white/90 backdrop-blur-xl">

    <div
        class="flex h-[@ResumeUtils.HeaderHeight] w-full items-center gap-1.5 px-2 sm:gap-2 sm:px-4 lg:gap-3 lg:px-6 xl:px-8">

        <div class="relative min-w-0 flex-1 overflow-hidden">

            <!-- LEFT FADE -->
            <div id="toolbarFadeLeft" class="pointer-events-none absolute left-0 top-0 z-20 h-full w-10
                bg-gradient-to-r from-white via-white/80 to-transparent
                opacity-0 transition-opacity duration-200">
            </div>


            <!-- LEFT ARROW -->
            <button id="toolbarScrollLeft" type="button" aria-label="Scroll toolbar left" title="Scroll left" class="absolute left-1 top-1/2 z-30 flex h-7 w-7
                -translate-y-1/2 items-center justify-center
                rounded-full border border-slate-200
                bg-white/95 text-slate-500 shadow-sm
                opacity-0 pointer-events-none
                transition-all duration-200
                hover:border-violet-300
                hover:bg-violet-50
                hover:text-violet-600
                active:scale-95">

                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">

                    <path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" />

                </svg>

            </button>


            <!-- ================================================= -->
            <!-- TOOLBAR                                          -->
            <!-- ================================================= -->

            <div id="resumeToolbar" class="flex w-full min-w-0 items-center
                justify-start gap-1 overflow-x-auto
                overscroll-x-contain px-10 py-1
                sm:gap-1.5 sm:px-10 sm:py-1
                lg:gap-2" style="
                scrollbar-width: none;
                -ms-overflow-style: none;
                cursor: grab;
                ">

                @foreach (var item in ResumeUtils.ToolItems)
                {
                    <button type="button" 
                    title="@item["Title"]" 
                    aria-label="@item["Title"]"
                    action-group="@item["ActionGroup"]"
                  child-id="@item["ChildId"]"
   
                    class="group flex shrink-0 select-none
                        items-center gap-1 rounded-lg
                        px-2 py-1.5 text-[9px]
                        font-semibold
                        transition-all duration-200
                        active:scale-95
                        sm:gap-1.5
                        sm:px-2.5 sm:py-2
                        sm:text-[10px]
                        lg:px-3
                        @item["ButtonClass"]
    "
                        
                        >

                        <!-- ICON -->

                        <span class="flex h-5 w-5 shrink-0
                            items-center justify-center
                            rounded-md
                            @item["IconClass"]
                            sm:h-6 sm:w-6">

                            @Html.Raw(item["Icon"])

                        </span>


                        <!-- TITLE -->

                        <span class="whitespace-nowrap">
                            @item["Title"]
                        </span>


                        <!-- BADGE -->

                        @if (!string.IsNullOrEmpty(item["Badge"]))
                        {
                            <span class="rounded
                                bg-emerald-50
                                px-1 py-0.5
                                text-[7px]
                                font-bold
                                text-emerald-600
                                sm:text-[8px]">

                                @item["Badge"]

                            </span>
                        }

                    </button>
                }

            </div>


            <!-- RIGHT ARROW -->

            <button id="toolbarScrollRight" type="button" aria-label="Scroll toolbar right" title="Scroll right" class="absolute right-1 top-1/2 z-30 flex h-7 w-7
                -translate-y-1/2 items-center justify-center
                rounded-full border border-slate-200
                bg-white/95 text-slate-500 shadow-sm
                opacity-0 pointer-events-none
                transition-all duration-200
                hover:border-violet-300
                hover:bg-violet-50
                hover:text-violet-600
                active:scale-95">

                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">

                    <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" />

                </svg>

            </button>


            <!-- RIGHT FADE -->

            <div id="toolbarFadeRight" class="pointer-events-none absolute right-0 top-0 z-20 h-full w-10
                bg-gradient-to-l from-white via-white/80 to-transparent
                opacity-0 transition-opacity duration-200">
            </div>

        </div>


        <!-- ===================================================== -->
        <!-- RIGHT ACTIONS                                        -->
        <!-- ===================================================== -->

        <div class="flex shrink-0 items-center gap-1 sm:gap-1.5 lg:gap-2">

            <!-- UNDO -->

            <button id="undoBtn" type="button" title="Undo" aria-label="Undo" class="hidden h-8 w-8 items-center justify-center
                rounded-lg border border-slate-200
                bg-white text-slate-500
                transition-all duration-200
                hover:border-violet-200
                hover:bg-violet-50
                hover:text-violet-600
                active:scale-95
                sm:flex sm:h-9 sm:w-9
                lg:h-10 lg:w-10">

                <svg class="h-3.5 w-3.5 lg:h-4 lg:w-4" fill="none" stroke="currentColor" stroke-width="1.8"
                     viewBox="0 0 24 24">

                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 7 4 12l5 5" />

                    <path stroke-linecap="round" d="M4 12h10a6 6 0 0 1 6 6" />

                </svg>

            </button>


            <!-- REDO -->

            <button id="redoBtn" type="button" title="Redo" aria-label="Redo" class="hidden h-8 w-8 items-center justify-center
                rounded-lg border border-slate-200
                bg-white text-slate-500
                transition-all duration-200
                hover:border-violet-200
                hover:bg-violet-50
                hover:text-violet-600
                active:scale-95
                sm:flex sm:h-9 sm:w-9
                lg:h-10 lg:w-10">

                <svg class="h-3.5 w-3.5 lg:h-4 lg:w-4" fill="none" stroke="currentColor" stroke-width="1.8"
                     viewBox="0 0 24 24">

                    <path stroke-linecap="round" stroke-linejoin="round" d="m15 7 5 5-5 5" />

                    <path stroke-linecap="round" d="M20 12H10a6 6 0 0 0-6 6" />

                </svg>

            </button>


            <!-- PREVIEW -->

            <button id="previewResumeBtn" type="button" title="Preview Resume" aria-label="Preview Resume" class="group flex h-8 w-8 shrink-0
                items-center justify-center
                rounded-lg border border-slate-200
                bg-white text-slate-500
                transition-all duration-200
                hover:border-violet-200
                hover:bg-violet-50
                hover:text-violet-600
                active:scale-95
                sm:h-9 sm:w-9
                lg:h-10 lg:w-10">

                <svg class="h-3.5 w-3.5
                    transition-transform duration-200
                    group-hover:scale-110
                    lg:h-4 lg:w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">

                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />

                    <circle cx="12" cy="12" r="2.5" />

                </svg>

            </button>


            <!-- DOWNLOAD -->

            <button id="downloadResumeBtn" type="button" title="Download Resume" aria-label="Download Resume" class="group flex h-8 w-8 shrink-0
                items-center justify-center
                rounded-lg
                bg-gradient-to-r
                from-violet-600
                to-indigo-600
                text-white
                shadow-sm
                shadow-violet-200
                transition-all duration-200
                hover:-translate-y-0.5
                hover:shadow-md
                active:scale-95
                sm:h-9 sm:w-9
                lg:h-10 lg:w-10">

                <svg class="h-3.5 w-3.5
                    transition-transform duration-200
                    group-hover:translate-y-0.5
                    lg:h-4 lg:w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">

                    <path stroke-linecap="round" d="M12 3v12" />

                    <path stroke-linecap="round" stroke-linejoin="round" d="m7 10 5 5 5-5" />

                    <path stroke-linecap="round" d="M5 21h14" />

                </svg>

            </button>

        </div>

    </div>
</header>

 


 