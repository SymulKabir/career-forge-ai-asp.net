<link rel="stylesheet" href="~/css/components/auth.css" asp-append-version="true" />
<script src="~/js/components/auth.js" asp-append-version="true" defer></script>


<div id="authModal" class="auth-modal fixed inset-0 z-[100] hidden" aria-hidden="true">

    <!-- BACKDROP -->
    <div id="authBackdrop" class="absolute inset-0 bg-slate-950/40 backdrop-blur-md">
    </div>


    <!-- MODAL WRAPPER -->
    <div class="relative min-h-screen w-full flex items-center justify-center p-4 sm:p-6">

        <!-- MODAL -->
        <div id="authDialog" role="dialog" aria-modal="true" aria-labelledby="authTitle"
             class="auth-dialog relative w-full max-h-[90vh] max-w-md overflow-x-hidden overflow-y-auto rounded-[28px] sm:rounded-[32px] bg-white border border-white/60 shadow-2xl scrollbar-hide">

            <!-- DECORATIVE BACKGROUND -->
            <div class="pointer-events-none absolute inset-0 ">

                <div class="absolute -top-32 -right-32 w-72 h-72 rounded-full bg-violet-300/20 blur-[80px]">
                </div>

                <div class="absolute -bottom-32 -left-32 w-72 h-72 rounded-full bg-cyan-300/20 blur-[80px]">
                </div>

            </div>


            <!-- CONTENT -->
            <div class="relative p-6 sm:p-8">

                <!-- CLOSE -->
                <button type="button" id="authClose" aria-label="Close authentication modal"
                        class="absolute right-5 top-5 w-9 h-9 rounded-xl flex items-center justify-center text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition">

                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">

                        <path d="M18 6L6 18" />
                        <path d="M6 6L18 18" />

                    </svg>

                </button>


                <!-- BRAND -->
                <div class="text-center pt-2">


                    <div
                        class="mx-auto   flex items-center justify-center ">

                       
                    <partial name="Components/Logo/Index"
                        view-data='new ViewDataDictionary(ViewData)
                        {
                            ["LogoMode"] = "half",
                            ["LogoSize"] = "w-12 h-12",
                            ["IconSize"] = "w-6 h-6"
                        }' />

                    </div>


                    <h2 id="authTitle"
                        class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 mt-5">

                        Welcome back

                    </h2>


                    <p id="authSubtitle" class="text-sm text-slate-500 mt-2">

                        Sign in to continue to CareerForge AI.

                    </p>

                </div>


                <!-- SOCIAL LOGIN -->
                <div class="grid grid-cols-3 gap-3 mt-7">

                    <!-- GOOGLE -->
                    <button type="button" class="social-auth-button">

                        <svg width="18" height="18" viewBox="0 0 24 24">
                            <path fill="#4285F4"
                                  d="M21.35 12.27c0-.73-.06-1.44-.18-2.12H12v4.01h5.24a4.48 4.48 0 0 1-1.94 2.94v2.44h3.14c1.84-1.69 2.91-4.18 2.91-7.27z" />
                            <path fill="#34A853"
                                  d="M12 21.7c2.63 0 4.84-.87 6.45-2.36l-3.14-2.44c-.87.58-1.98.92-3.31.92-2.55 0-4.71-1.72-5.49-4.03H3.27v2.52A9.74 9.74 0 0 0 12 21.7z" />
                            <path fill="#FBBC05"
                                  d="M6.51 13.79a5.86 5.86 0 0 1 0-3.74V7.53H3.27a9.72 9.72 0 0 0 0 8.78l3.24-2.52z" />
                            <path fill="#EA4335"
                                  d="M12 6.02c1.43 0 2.72.49 3.74 1.46l2.8-2.8C16.84 3.1 14.63 2.3 12 2.3a9.74 9.74 0 0 0-8.73 5.23l3.24 2.52C7.29 7.74 9.45 6.02 12 6.02z" />
                        </svg>

                        <span class="hidden sm:inline">Google</span>

                    </button>


                    <!-- FACEBOOK -->
                    <button type="button" class="social-auth-button">

                        <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2">

                            <path
                            d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.17 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.96h-1.51c-1.49 0-1.95.93-1.95 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.17 24 18.1 24 12.07Z" />

                        </svg>

                        <span class="hidden sm:inline">Facebook</span>

                    </button>


                    <!-- LINKEDIN -->
                    <button type="button" class="social-auth-button">

                        <svg width="18" height="18" viewBox="0 0 24 24" fill="#0A66C2">

                            <path
                            d="M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.95v5.67H9.34V8.98h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.3ZM5.32 7.42a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM3.54 20.45H7.1V8.98H3.54v11.47ZM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0Z" />

                        </svg>

                        <span class="hidden sm:inline">LinkedIn</span>

                    </button>

                </div>


                <!-- DIVIDER -->
                <div class="flex items-center gap-4 my-6">

                    <div class="h-px bg-slate-200 flex-1"></div>

                    <span class="text-[11px] text-slate-400 uppercase tracking-wider">
                        Or continue with email
                    </span>

                    <div class="h-px bg-slate-200 flex-1"></div>

                </div>


                <!-- FORM -->
                <form id="authForm" class="space-y-4">

                    <!-- NAME -->
                    <div id="nameField" class="auth-field hidden">

                        <label for="authName" class="auth-label">

                            Full name

                        </label>

                        <div class="relative">

                            <input id="authName" type="text" autocomplete="name" placeholder="John Doe"
                                   class="auth-input pl-11" />

                            <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2">

                                <path d="M20 21a8 8 0 0 0-16 0" />
                                <circle cx="12" cy="7" r="4" />

                            </svg>

                        </div>

                    </div>


                    <!-- EMAIL -->
                    <div class="auth-field">

                        <label for="authEmail" class="auth-label">

                            Email address

                        </label>

                        <div class="relative">

                            <input id="authEmail" type="email" autocomplete="email" placeholder="you@example.com"
                                   required class="auth-input pl-11" />

                            <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2">

                                <rect x="3" y="5" width="18" height="14" rx="2" />

                                <path d="m3 7 9 6 9-6" />

                            </svg>

                        </div>

                    </div>


                    <!-- PASSWORD -->
                    <div class="auth-field">

                        <div class="flex items-center justify-between">

                            <label for="authPassword" class="auth-label">

                                Password

                            </label>

                            <button id="forgotPassword" type="button"
                                    class="text-xs text-violet-600 hover:text-violet-800">

                                Forgot password?

                            </button>

                        </div>

                        <div class="relative">

                            <input id="authPassword" type="password" autocomplete="current-password"
                                   placeholder="••••••••" required class="auth-input pl-11 pr-12" />

                            <svg class="auth-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2">

                                <rect x="4" y="11" width="16" height="10" rx="2" />

                                <path d="M8 11V7a4 4 0 0 1 8 0v4" />

                            </svg>

                            <button type="button" id="togglePassword"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700">

                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2">

                                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />

                                </svg>

                            </button>

                        </div>

                    </div>


                    <!-- PASSWORD STRENGTH -->
                    <div id="passwordStrength" class="hidden">

                        <div class="flex gap-1">

                            <span class="strength-bar"></span>
                            <span class="strength-bar"></span>
                            <span class="strength-bar"></span>
                            <span class="strength-bar"></span>

                        </div>

                        <p id="strengthText" class="text-[10px] text-slate-400 mt-1">
                        </p>

                    </div>


                    <!-- REMEMBER -->
                    <div id="rememberContainer" class="flex items-center justify-between">

                        <label class="flex items-center gap-2 cursor-pointer">

                            <input type="checkbox"
                                   class="w-4 h-4 rounded border-slate-300 text-violet-600 focus:ring-violet-500" />

                            <span class="text-xs text-slate-500">
                                Remember me
                            </span>

                        </label>

                    </div>


                    <!-- SUBMIT -->
                    <button id="authSubmit" type="submit"
                            class="primary-button w-full py-3.5 rounded-xl text-white font-semibold flex items-center justify-center gap-2">

                        <span id="submitText">
                            Sign in
                        </span>

                        <span id="submitLoader"
                              class="hidden w-4 h-4 border-2 border-white/40 border-t-white rounded-full animate-spin">
                        </span>

                    </button>

                </form>


                <!-- SWITCH -->
                <div class="text-center mt-6">

                    <p class="text-sm text-slate-500">

                        <span id="switchText">
                            Don't have an account?
                        </span>

                        <button type="button" id="authSwitch"
                                class="font-semibold text-violet-600 hover:text-violet-800 ml-1">

                            Create account

                        </button>

                    </p>

                </div>


                <!-- TERMS -->
                <p id="termsText" class="text-[10px] text-slate-400 text-center leading-5 mt-5">

                    By continuing, you agree to our
                    <a href="#" class="text-slate-500 hover:text-violet-600">
                        Terms
                    </a>
                    and
                    <a href="#" class="text-slate-500 hover:text-violet-600">
                        Privacy Policy
                    </a>.

                </p>

            </div>

        </div>

    </div>

</div>