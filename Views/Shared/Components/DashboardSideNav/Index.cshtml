    </a>

    <!-- Profile -->
    <a href="#"
       class="mobile-nav-item flex min-w-[55px] flex-col items-center gap-1 py-1 text-[9px] font-semibold text-slate-400 @(IsActive("Index") ? "active" : "")">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <circle cx="12" cy="8" r="3" />
        <path d="M5 20c.7-3.5 3-5 7-5s6.3 1.5 7 5" />
